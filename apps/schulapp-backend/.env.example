DATABASE_URL=postgres://user:pass@localhost:5432/schulapp?sslmode=disable
JWT_SECRET=change-me-in-production
PORT=8080
UPLOAD_DIR=./uploads
# SchoolConnect-Sidecar ("schoolconnect serve", v0.3.0 Multi-Tenant,
# SC_REQUIRE_TENANT=true). Im Compose-Netz via Service-Name erreichbar;
# lokal ohne Compose auf einen manuell gestarteten Sidecar zeigen.
SCHOOLCONNECT_BASE_URL=http://schoolconnect:8081
# Optional: HMAC-Signatur für X-SC-Tenant (muss zu
# SC_TENANT_SHARED_SECRET des Sidecars passen).
SC_TENANT_SHARED_SECRET=
