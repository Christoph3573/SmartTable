POSTGRES_USER={{ postgres_user | default('schulapp') }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db | default('schulapp') }}
JWT_SECRET={{ jwt_secret }}
UPLOAD_DIR=/app/uploads
# SchoolConnect v0.3.0 als Sidecar-Service im Compose-Netz (nur internes
# Netz, kein Host-Port). Der Proxy setzt X-SC-Tenant aus der JWT-user_id
# (pro App-Benutzer isoliert).
SCHOOLCONNECT_BASE_URL={{ schoolconnect_base_url | default('http://schoolconnect:8081') }}
SC_TENANT_SHARED_SECRET={{ sc_tenant_shared_secret | default('') }}
SC_LOG_LEVEL={{ sc_log_level | default('info') }}
# OpenCode (KI-Lernchat, Agent-Runtime): gemeinsamer Sidecar-Service für
# alle User, nur internes Compose-Netz (kein Host-Port). Der Container nutzt
# den Key global für alle Tenant-Sessions; Tenant-Trennung via
# /workspaces/<user_id> + Ownership-Checks im Backend (JWT-Grenze).
OPENCODE_VERSION={{ opencode_version | default('v1.18.32') }}
OPENCODE_BASE_URL={{ opencode_base_url | default('http://opencode:8082') }}
OPENROUTER_API_KEY={{ openrouter_api_key | default('') }}
