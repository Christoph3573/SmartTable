POSTGRES_USER={{ postgres_user | default('schulapp') }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db | default('schulapp') }}
JWT_SECRET={{ jwt_secret }}
UPLOAD_DIR=/app/uploads
# SchoolConnect-REST auf dem Host (systemd-Service aus der Rolle
# schoolconnect). Aus dem Backend-Container via host-gateway auflösen —
# siehe extra_hosts im docker-compose.yml.j2.
SCHOOLCONNECT_BASE_URL={{ schoolconnect_base_url | default('http://host.docker.internal:8081') }}
