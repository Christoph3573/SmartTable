services:
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-schulapp}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-schulapp}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-schulapp} -d ${POSTGRES_DB:-schulapp}"]
      interval: 5s
      timeout: 5s
      retries: 5
    ports:
      - "127.0.0.1:{{ postgres_host_port }}:5432"
    restart: unless-stopped

  migrate:
    image: migrate/migrate:v4.18.2
    command:
      - -path
      - /migrations
      - -database
      - postgres://${POSTGRES_USER:-schulapp}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-schulapp}?sslmode=disable
      - up
    volumes:
      - ./backend/migrations:/migrations
    depends_on:
      postgres:
        condition: service_healthy
    restart: no

  backend:
    build:
      context: ./backend
    environment:
      DATABASE_URL: postgres://${POSTGRES_USER:-schulapp}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-schulapp}?sslmode=disable
      JWT_SECRET: ${JWT_SECRET}
      PORT: "8080"
      UPLOAD_DIR: ${UPLOAD_DIR:-/app/uploads}
      # SchoolConnect läuft als systemd-Service auf dem Host (Rolle
      # schoolconnect, Default 127.0.0.1:8081). Aus dem Container ist der
      # Host über das host-gateway erreichbar — extra_hosts unten setzt
      # host.docker.internal darauf (Linux-Docker versteht den Namen sonst
      # nicht). Wer SchoolConnect lieber als Compose-Service betreiben will,
      # setzt SCHOOLCONNECT_BASE_URL=http://schoolconnect:8081 und ergänzt
      # den Service in diesem Template.
      SCHOOLCONNECT_BASE_URL: ${SCHOOLCONNECT_BASE_URL:-http://host.docker.internal:8081}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      migrate:
        condition: service_completed_successfully
    volumes:
      - uploads_data:/app/uploads
    restart: unless-stopped

  frontend:
    build:
      context: ./frontend
      args:
        VITE_API_BASE: ""
    depends_on:
      - backend
    ports:
      - "127.0.0.1:{{ tunnel_local_port }}:80"
    restart: unless-stopped

volumes:
  postgres_data:
  uploads_data:
