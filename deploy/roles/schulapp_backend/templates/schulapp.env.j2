DATABASE_URL=postgres://{{ postgres_user }}:{{ postgres_password }}@127.0.0.1:{{ postgres_host_port }}/{{ postgres_db }}?sslmode=disable
JWT_SECRET={{ jwt_secret }}
PORT={{ backend_port }}
UPLOAD_DIR=/var/lib/schulapp/uploads
# SchoolConnect wird in dieser Rolle nicht mehr als systemd-Service betrieben
# (alte Rolle archiviert unter roles/schoolconnect.systemd.disabled) — der
# Compose-Deploy (Rollen schulapp_docker) nutzt den v0.3.0-Sidecar
# (http://schoolconnect:8081, X-SC-Tenant aus JWT-user_id). Falls lokal ein
# manueller Sidecar läuft, hier dessen URL eintragen.
SCHOOLCONNECT_BASE_URL={{ schoolconnect_base_url | default('http://127.0.0.1:8081') }}
SC_TENANT_SHARED_SECRET={{ sc_tenant_shared_secret | default('') }}
