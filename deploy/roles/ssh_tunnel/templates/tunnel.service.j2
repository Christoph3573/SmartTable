[Unit]
Description=Reverse SSH Tunnel to codeclub VM (Website)
After=network-online.target
Wants=network-online.target

[Service]
User={{ tunnel_user }}
ExecStart=/usr/bin/autossh -M 0 \
  -o "ServerAliveInterval 30" \
  -o "ServerAliveCountMax 3" \
  -o "ExitOnForwardFailure yes" \
  -i /home/{{ tunnel_user }}/.ssh/id_tunnel \
  -N -R {{ tunnel_remote_port }}:127.0.0.1:{{ tunnel_local_port }} {{ tunnel_remote_user }}@{{ tunnel_remote_host }}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target