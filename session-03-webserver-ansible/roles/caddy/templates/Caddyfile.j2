# The Caddyfile is an easy way to configure your Caddy web server.
#
# :{{ tunnel_local_port }} statt eines Literal-Ports — muss zum lokalen Ende
# des Reverse-Tunnels dieses Hosts passen (siehe host_vars/<host>/vars.yml).
:{{ tunnel_local_port }} {
    encode gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:{{ backend_port }}
    }

    handle {
        root * {{ caddy_site_root }}
        try_files {path} /index.html
        file_server
    }
}
