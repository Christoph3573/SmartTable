[Unit]
Description=Reverse SSH Tunnel to codeclub VM (Website)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
ExecStart=/usr/bin/autossh -M 0 \
  -o "ServerAliveInterval 30" \
  -o "ServerAliveCountMax 3" \
  -o "ExitOnForwardFailure yes" \
  -i /home/pi/.ssh/id_tunnel \
  -N -R 16060:127.0.0.1:80 tunnel-christoph@codeclub.check24.fun
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
